<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MultiReplacer.App.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MultiReplacer.App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="20,12,20,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目标程序 -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10,14,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Resolve.exe" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox Grid.Column="1" x:Name="TxtExe" PlaceholderText="选择 DaVinci Resolve 主程序"
                         VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="BtnBrowse" Content="浏览…" Click="OnBrowse" />
                <Button Grid.Column="3" x:Name="BtnScan" Content="扫描" Style="{StaticResource AccentButtonStyle}"
                        Click="OnScan" />
            </Grid>
        </Border>

        <InfoBar Grid.Row="1" x:Name="HeaderInfo" IsOpen="False" IsClosable="False"
                 Severity="Informational" Title="尚未扫描" Message="" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 资源列表 -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10,12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFilter" PlaceholderText="按编号 / 尺寸 / 偏移筛选" TextChanged="OnFilterTextChanged" />
                        <NumberBox Grid.Column="1" x:Name="NumMin" Value="300" Minimum="0" Maximum="8192"
                                   SpinButtonPlacementMode="Compact" Width="112"
                                   PlaceholderText="最小边长" ValueChanged="OnFilterNumberChanged" />
                        <ToggleSwitch Grid.Column="2" x:Name="ChkSplashOnly" OnContent="仅启动图" OffContent="仅启动图"
                                      IsOn="True" Toggled="OnFilterToggled" MinWidth="0" />
                        <ToggleSwitch Grid.Column="3" x:Name="ChkLogoOnly" OnContent="仅 Logo" OffContent="仅 Logo"
                                      Toggled="OnFilterToggled" MinWidth="0" />
                        <Button Grid.Column="4" x:Name="BtnSameSize" Content="全选同尺寸" Click="OnSelectSameSize" />
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="ListHint" Text="支持 Shift / Ctrl 多选，也可拖动框选"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView Grid.Row="2" x:Name="LvAssets" SelectionMode="Extended"
                              SelectionChanged="OnAssetSelectionChanged"
                              IsItemClickEnabled="False">
                        <ListView.Header>
                            <Grid Padding="12,0,12,4" ColumnSpacing="8" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="尺寸" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="字节" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="文件偏移" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="颜色" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="判定" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AssetRow">
                                <Grid ColumnSpacing="8" Padding="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Index}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Dimensions}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Bytes}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Offset}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Color}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Judgement}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 预览与替换图 -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10,12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="原启动图" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Image x:Name="ImgOriginal" Stretch="Uniform" Margin="4" />
                        </Border>
                        <TextBlock x:Name="TxtOriginalInfo" Text="未选择资源" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="新图片" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                        <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Image x:Name="ImgNew" Stretch="Uniform" Margin="4" />
                        </Border>
                        <TextBlock x:Name="TxtNewInfo" Text="尚未选择替换图" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnChoosePng" Content="选择新的 PNG…" HorizontalAlignment="Stretch"
                                    Click="OnChooseReplacement" />
                            <Button Grid.Column="1" x:Name="BtnExportOriginal" Content="导出原图"
                                    Click="OnExportOriginal" />
                        </Grid>

                        <CheckBox x:Name="ChkCopies" Content="同时替换内容完全相同的副本" IsChecked="True" />
                        <CheckBox x:Name="ChkClearSig" Content="清除失效的 Authenticode 目录（非必需）" />

                        <TextBlock Text="日志" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                        <Border Height="120" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer>
                                <TextBlock x:Name="TxtLog" Text="" FontFamily="Consolas" FontSize="11"
                                           Padding="8" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 命令栏 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCreatePatch" Content="生成补丁副本…" Click="OnCreatePatch" />
            <Button Grid.Column="1" x:Name="BtnApply" Content="直接应用" Style="{StaticResource AccentButtonStyle}"
                    Click="OnApplyPatch" />
            <Button Grid.Column="2" x:Name="BtnRestore" Content="恢复原始备份" Click="OnRestore" />
            <ProgressRing Grid.Column="3" x:Name="Busy" IsActive="False" Width="20" Height="20"
                          HorizontalAlignment="Left" Margin="8,0,0,0" />
            <TextBlock Grid.Column="4" x:Name="TxtSelection" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
