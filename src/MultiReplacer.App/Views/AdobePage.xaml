<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MultiReplacer.App.Views.AdobePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MultiReplacer.App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="20,12,20,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10,14,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Adobe 应用" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox Grid.Column="1" x:Name="CboApp" HorizontalAlignment="Stretch"
                          DisplayMemberPath="Display"
                          PlaceholderText="未检测到可替换字体语言包的 Adobe 应用"
                          SelectionChanged="OnAppChanged" />
                <Button Grid.Column="2" Content="重新检测" Click="OnRediscover" />
                <Button Grid.Column="3" Content="手动选择…" Click="OnBrowseLocale" />
            </Grid>
        </Border>

        <InfoBar Grid.Row="1" x:Name="StatusBar" IsOpen="True" IsClosable="False"
                 Severity="Informational" Title="未检测"
                 Message="点击[重新检测]扫描已安装的 Adobe 应用（After Effects / Premiere Pro / Media Encoder / Audition 等）。" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10,12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFontFilter" PlaceholderText="搜索字体族名" TextChanged="OnFontFilterChanged" />
                        <TextBlock Grid.Column="1" x:Name="TxtKeyInfo" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="列表只显示系统已安装的字体族；推荐 Microsoft YaHei UI。选择方式与达芬奇 UI 字体一致。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView Grid.Row="2" x:Name="LvFonts" SelectionMode="Single"
                              SelectionChanged="OnFontSelectionChanged">
                        <ListView.Header>
                            <Grid Padding="12,0,12,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="字体族名" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="状态" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="字节" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="说明" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FontRow">
                                <Grid ColumnSpacing="8" Padding="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Bytes}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Note}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10,12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="当前状态" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="1" x:Name="TxtDetail" Text="尚未检测" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="NumLarge" Header="大号" Minimum="6" Maximum="30"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" x:Name="NumMedium" Header="中号" Minimum="6" Maximum="30"
                                   SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="2" x:Name="NumSmall" Header="小号" Minimum="6" Maximum="30"
                                   SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <Border Grid.Row="3" Padding="10" CornerRadius="6"
                            Background="{ThemeResource LayerFillColorAltBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="替换说明" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Adobe 应用界面字体来自 Dictionaries 语言包里的 FontStyle 键。本工具只改字体与字号，保留原文件编码/换行，并同步 META-INF 摘要。" />
                            <CheckBox x:Name="ChkPluginFonts" Content="同时替换插件对话框字体" MinWidth="0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4" ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnApplyFont" Content="应用所选字体" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Click="OnApplyFont" />
                        <Button Grid.Column="1" x:Name="BtnRestoreFont" Content="恢复官方语言包" Click="OnRestoreFont" />
                    </Grid>

                    <Grid Grid.Row="5" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer>
                                <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11" Padding="8"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="TxtBackup" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="备份路径：-" />
    </Grid>
</Page>
